<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Lemon.Inside.Book.ViewModels"
             xmlns:views="using:Lemon.Inside.Book.Views"
             xmlns:shellViews="using:Lemon.Book.Shell.Views"
             xmlns:pages="using:Lemon.Inside.Book.ViewModels.Pages"
             xmlns:pageViews="using:Lemon.Inside.Book.Views.Pages"
             xmlns:controls="using:Lemon.Book.Shell.Controls"
             xmlns:light="using:Lemon.Inside.Book.Chapters.LightShadow"
             xmlns:gears="using:Lemon.Inside.Book.Chapters.Gears"
             xmlns:watch="using:Lemon.Inside.Book.Chapters.Watch"
             xmlns:bicycle="using:Lemon.Inside.Book.Chapters.Bicycle"
             xmlns:boats="using:Lemon.Inside.Book.Chapters.Boats"
             xmlns:car="using:Lemon.Inside.Book.Chapters.Car"
             xmlns:locks="using:Lemon.Inside.Book.Chapters.Locks"
             xmlns:lifting="using:Lemon.Inside.Book.Chapters.Lifting"
             xmlns:plumbing="using:Lemon.Inside.Book.Chapters.Plumbing"
             xmlns:bridges="using:Lemon.Inside.Book.Chapters.Bridges"
             xmlns:weighing="using:Lemon.Inside.Book.Chapters.Weighing"
             xmlns:friction="using:Lemon.Inside.Book.Chapters.Friction"
             xmlns:canals="using:Lemon.Inside.Book.Chapters.Canals"
             xmlns:sewing="using:Lemon.Inside.Book.Chapters.Sewing"
             xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="Lemon.Inside.Book.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#2A1D15">

    <!--
        One view per page type; BookView's presenters pick them up from here. The first match wins, so a ported
        chapter's page types (subclasses of the placeholder pages) come first.
    -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="light:LightShadowTextPageViewModel"><light:LightShadowTextPageView /></DataTemplate>
        <DataTemplate DataType="light:LightShadowDiagramPageViewModel"><light:LightShadowDiagramPageView /></DataTemplate>
        <DataTemplate DataType="gears:GearsTextPageViewModel"><gears:GearsTextPageView /></DataTemplate>
        <DataTemplate DataType="gears:GearsDiagramPageViewModel"><gears:GearsDiagramPageView /></DataTemplate>
        <DataTemplate DataType="watch:WatchTextPageViewModel"><watch:WatchTextPageView /></DataTemplate>
        <DataTemplate DataType="watch:WatchDiagramPageViewModel"><watch:WatchDiagramPageView /></DataTemplate>
        <DataTemplate DataType="bicycle:BicycleTextPageViewModel"><bicycle:BicycleTextPageView /></DataTemplate>
        <DataTemplate DataType="bicycle:BicycleDiagramPageViewModel"><bicycle:BicycleDiagramPageView /></DataTemplate>
        <DataTemplate DataType="boats:BoatsTextPageViewModel"><boats:BoatsTextPageView /></DataTemplate>
        <DataTemplate DataType="boats:BoatsDiagramPageViewModel"><boats:BoatsDiagramPageView /></DataTemplate>
        <DataTemplate DataType="car:CarTextPageViewModel"><car:CarTextPageView /></DataTemplate>
        <DataTemplate DataType="car:CarDiagramPageViewModel"><car:CarDiagramPageView /></DataTemplate>
        <DataTemplate DataType="locks:LocksTextPageViewModel"><locks:LocksTextPageView /></DataTemplate>
        <DataTemplate DataType="locks:LocksDiagramPageViewModel"><locks:LocksDiagramPageView /></DataTemplate>
        <DataTemplate DataType="lifting:LiftingTextPageViewModel"><lifting:LiftingTextPageView /></DataTemplate>
        <DataTemplate DataType="lifting:LiftingDiagramPageViewModel"><lifting:LiftingDiagramPageView /></DataTemplate>
        <DataTemplate DataType="plumbing:PlumbingTextPageViewModel"><plumbing:PlumbingTextPageView /></DataTemplate>
        <DataTemplate DataType="plumbing:PlumbingDiagramPageViewModel"><plumbing:PlumbingDiagramPageView /></DataTemplate>
        <DataTemplate DataType="bridges:BridgesTextPageViewModel"><bridges:BridgesTextPageView /></DataTemplate>
        <DataTemplate DataType="bridges:BridgesDiagramPageViewModel"><bridges:BridgesDiagramPageView /></DataTemplate>
        <DataTemplate DataType="weighing:WeighingTextPageViewModel"><weighing:WeighingTextPageView /></DataTemplate>
        <DataTemplate DataType="weighing:WeighingDiagramPageViewModel"><weighing:WeighingDiagramPageView /></DataTemplate>
        <DataTemplate DataType="friction:FrictionTextPageViewModel"><friction:FrictionTextPageView /></DataTemplate>
        <DataTemplate DataType="friction:FrictionDiagramPageViewModel"><friction:FrictionDiagramPageView /></DataTemplate>
        <DataTemplate DataType="canals:CanalsTextPageViewModel"><canals:CanalsTextPageView /></DataTemplate>
        <DataTemplate DataType="canals:CanalsDiagramPageViewModel"><canals:CanalsDiagramPageView /></DataTemplate>
        <DataTemplate DataType="sewing:SewingTextPageViewModel"><sewing:SewingTextPageView /></DataTemplate>
        <DataTemplate DataType="sewing:SewingDiagramPageViewModel"><sewing:SewingDiagramPageView /></DataTemplate>
        <DataTemplate DataType="pages:CoverPageViewModel"><pageViews:CoverPageView /></DataTemplate>
        <DataTemplate DataType="pages:HowToUsePageViewModel"><pageViews:HowToUsePageView /></DataTemplate>
        <DataTemplate DataType="pages:TitlePageViewModel"><pageViews:TitlePageView /></DataTemplate>
        <DataTemplate DataType="pages:ContentsPageViewModel"><pageViews:ContentsPageView /></DataTemplate>
        <DataTemplate DataType="pages:ChapterTextPageViewModel"><pageViews:ChapterTextPageView /></DataTemplate>
        <DataTemplate DataType="pages:ChapterDiagramPageViewModel"><pageViews:ChapterDiagramPageView /></DataTemplate>
        <DataTemplate DataType="pages:CreditsPageViewModel"><pageViews:CreditsPageView /></DataTemplate>
        <DataTemplate DataType="pages:BackCoverPageViewModel"><pageViews:BackCoverPageView /></DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding Bookmarks.ToggleCurrentCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <!--
            The toolbar is also the window's title bar on the desktop (MainWindow extends the book into it): drag it to
            move the window, double-click to maximize, and on Windows 11 hover the maximize button for snap layouts.
            ElementRole tells the system which part is which; the book's own buttons are "User" so they stay clickable.
        -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Classes="toolbar" WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="TitleText" Classes="toolbarTitle" Text="{loc:Localize App_Title}" />
                <!-- Minimize, maximize / restore and close: shown by MainWindow on Windows and Linux. -->
                <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" Margin="10,-6,-12,-6"
                            IsVisible="False">
                    <Button Classes="caption" Click="OnMinimizeClick"
                            ToolTip.Tip="{loc:Localize Window_Minimize}" AutomationProperties.Name="{loc:Localize Window_Minimize}"
                            WindowDecorationProperties.ElementRole="MinimizeButton">
                        <PathIcon Data="{StaticResource Icon.WindowMinimize}" />
                    </Button>
                    <Button Classes="caption" Click="OnMaximizeClick"
                            ToolTip.Tip="{loc:Localize Window_Maximize}" AutomationProperties.Name="{loc:Localize Window_Maximize}"
                            WindowDecorationProperties.ElementRole="MaximizeButton">
                        <PathIcon x:Name="MaximizeIcon" Data="{StaticResource Icon.WindowMaximize}" />
                    </Button>
                    <Button Classes="caption close" Click="OnCloseClick"
                            ToolTip.Tip="{loc:Localize Window_Close}" AutomationProperties.Name="{loc:Localize Window_Close}"
                            WindowDecorationProperties.ElementRole="CloseButton">
                        <PathIcon Data="{StaticResource Icon.WindowClose}" />
                    </Button>
                </StackPanel>
                <!--
                    The buttons scroll sideways if they ever outgrow the window (very narrow screens, large text), so
                    Settings is always within reach. On a phone they are icons only and fit (App.axaml, .narrow).
                -->
                <ScrollViewer Grid.Column="1" HorizontalAlignment="Right" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Classes="toolbarButtons" Orientation="Horizontal" Spacing="6"
                                WindowDecorationProperties.ElementRole="User">
                        <Button Content="&#x2039;" Click="OnPreviousClick"
                                ToolTip.Tip="{loc:Localize Toolbar_Previous}"
                                AutomationProperties.Name="{loc:Localize Toolbar_Previous}" />
                        <Button Content="&#x203A;" Click="OnNextClick"
                                ToolTip.Tip="{loc:Localize Toolbar_Next}"
                                AutomationProperties.Name="{loc:Localize Toolbar_Next}" />
                        <Button Command="{Binding GoToContentsCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar_Contents}"
                                AutomationProperties.Name="{loc:Localize Toolbar_Contents}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Contents}" />
                                <TextBlock Classes="toolbarLabel" VerticalAlignment="Center" Text="{loc:Localize Toolbar_Contents}" />
                            </StackPanel>
                        </Button>
                        <!-- Bookmarks: mark this page, or turn to a marked one -->
                        <Button x:Name="BookmarksButton"
                                ToolTip.Tip="{loc:Localize Bookmarks_Tip}"
                                AutomationProperties.Name="{loc:Localize Bookmarks_Title}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Bookmark}" />
                                <TextBlock Classes="toolbarLabel" VerticalAlignment="Center" Text="{loc:Localize Bookmarks_Title}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper">
                                    <shellViews:BookmarksView DataContext="{Binding Bookmarks}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Notes: write on the reading page, quote its text, export them all -->
                        <Button x:Name="NotesButton"
                                ToolTip.Tip="{loc:Localize Notes_Tip}"
                                AutomationProperties.Name="{loc:Localize Notes_Title}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Note}" />
                                <TextBlock Classes="toolbarLabel" VerticalAlignment="Center" Text="{loc:Localize Notes_Title}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper">
                                    <shellViews:NotesView x:Name="NotesPanel" DataContext="{Binding Notes}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Everything the reader can set, in one place -->
                        <Button x:Name="SettingsButton"
                                ToolTip.Tip="{loc:Localize Settings_Tip}"
                                AutomationProperties.Name="{loc:Localize Settings_Title}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Settings}" />
                                <TextBlock Classes="toolbarLabel" VerticalAlignment="Center" Text="{loc:Localize Settings_Title}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper settings">
                                    <views:SettingsView DataContext="{Binding Settings}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- A new version (or how the last update went): under the title bar, until installed or put off. -->
        <Border DockPanel.Dock="Top" Classes="updateBanner" IsVisible="{Binding Update.ShowsBanner}">
            <StackPanel Spacing="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                        <Button Classes="bannerPrimary" IsVisible="{Binding !Update.HasNotice}"
                                Command="{Binding Update.InstallOrDownloadCommand}" Content="{Binding Update.PrimaryButtonText}" />
                        <Button Classes="banner" IsVisible="{Binding Update.ReleaseNotes, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Content="{loc:Localize Update_WhatsNew}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="paper">
                                    <StackPanel>
                                        <TextBlock Classes="kicker" Margin="0,12,0,6" Text="{loc:Localize Update_WhatsNew}" />
                                        <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                                            <SelectableTextBlock Classes="text" FontSize="13" Text="{Binding Update.ReleaseNotes}" />
                                        </ScrollViewer>
                                        <Button Classes="chip" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Command="{Binding Update.OpenReleasePageCommand}" Content="{loc:Localize Update_ReleasePage}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="banner" Command="{Binding Update.DismissCommand}" Content="{loc:Localize Update_Later}" />
                    </StackPanel>
                    <TextBlock Classes="bannerText" IsVisible="{Binding !Update.HasNotice}" Text="{Binding Update.BannerText}" />
                    <TextBlock Classes="bannerText" IsVisible="{Binding Update.HasNotice}" Text="{Binding Update.Notice}" />
                </DockPanel>
                <StackPanel IsVisible="{Binding Update.IsInstalling}" Spacing="4">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Update.Progress}"
                                 IsIndeterminate="{Binding Update.IsProgressIndeterminate}" />
                    <TextBlock Classes="bannerText" FontSize="12" Text="{Binding Update.ProgressText}" />
                </StackPanel>
                <TextBlock Classes="bannerText" FontSize="12" Foreground="#FFE3DA"
                           IsVisible="{Binding Update.HasInstallError}" Text="{Binding Update.InstallError}" />
            </StackPanel>
        </Border>

        <controls:BookView x:Name="Book"
                           Pages="{Binding Pages}"
                           PageIndex="{Binding PageIndex}"
                           AnimatesTurns="{Binding Settings.AnimatesTurns}"
                           BookmarkedPages="{Binding Bookmarks.MarkedPages}" />
    </DockPanel>
</UserControl>
