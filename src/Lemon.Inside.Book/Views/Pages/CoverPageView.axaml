<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lemon.Inside.Book.ViewModels.Pages"
             xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
             x:Class="Lemon.Inside.Book.Views.Pages.CoverPageView"
             x:DataType="pages:CoverPageViewModel"
             Background="{StaticResource CoverBrush}">
    <Grid>
        <!-- Decoration only: a lamp shining on two meshing gears behind the title (the gears match the icon, made by
             scripts/appicon/make-icons.py: 16 and 10 teeth of one size, turned so each tooth sits in a gap). -->
        <Viewbox Stretch="Uniform" Margin="36" Opacity="0.5" IsHitTestVisible="False">
            <Canvas Width="400" Height="400">
                <!-- The lamp, its glow and three rays falling towards the gears. -->
                <Ellipse Canvas.Left="24.0" Canvas.Top="24.0" Width="92" Height="92" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="2,5" />
                <Ellipse Canvas.Left="56.0" Canvas.Top="56.0" Width="28" Height="28" Fill="#E9C46A" />
                <Line StartPoint="98,98" EndPoint="132,132" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="4,6" />
                <Line StartPoint="108,78" EndPoint="196,110" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="4,6" />
                <Line StartPoint="78,108" EndPoint="100,180" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="4,6" />
                <Path Data="M251.0,240.0 L250.8,246.4 L277.0,254.8 L274.5,267.3 L247.0,265.0 L244.8,271.0 L242.2,276.8 L263.2,294.6 L256.1,305.2 L231.6,292.6 L227.3,297.3 L222.6,301.6 L235.2,326.1 L224.6,333.2 L206.8,312.2 L201.0,314.8 L195.0,317.0 L197.3,344.5 L184.8,347.0 L176.4,320.8 L170.0,321.0 L163.6,320.8 L155.2,347.0 L142.7,344.5 L145.0,317.0 L139.0,314.8 L133.2,312.2 L115.4,333.2 L104.8,326.1 L117.4,301.6 L112.7,297.3 L108.4,292.6 L83.9,305.2 L76.8,294.6 L97.8,276.8 L95.2,271.0 L93.0,265.0 L65.5,267.3 L63.0,254.8 L89.2,246.4 L89.0,240.0 L89.2,233.6 L63.0,225.2 L65.5,212.7 L93.0,215.0 L95.2,209.0 L97.8,203.2 L76.8,185.4 L83.9,174.8 L108.4,187.4 L112.7,182.7 L117.4,178.4 L104.8,153.9 L115.4,146.8 L133.2,167.8 L139.0,165.2 L145.0,163.0 L142.7,135.5 L155.2,133.0 L163.6,159.2 L170.0,159.0 L176.4,159.2 L184.8,133.0 L197.3,135.5 L195.0,163.0 L201.0,165.2 L206.8,167.8 L224.6,146.8 L235.2,153.9 L222.6,178.4 L227.3,182.7 L231.6,187.4 L256.1,174.8 L263.2,185.4 L242.2,203.2 L244.8,209.0 L247.0,215.0 L274.5,212.7 L277.0,225.2 L250.8,233.6 Z" Stroke="#E9C46A" StrokeThickness="1" />
                <Ellipse Canvas.Left="149.0" Canvas.Top="219.0" Width="42" Height="42" Stroke="#E9C46A" StrokeThickness="1" />
                <Ellipse Canvas.Left="189.3" Canvas.Top="259.3" Width="36" Height="36" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="2,4" />
                <Ellipse Canvas.Left="114.7" Canvas.Top="259.3" Width="36" Height="36" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="2,4" />
                <Ellipse Canvas.Left="114.7" Canvas.Top="184.7" Width="36" Height="36" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="2,4" />
                <Ellipse Canvas.Left="189.3" Canvas.Top="184.7" Width="36" Height="36" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="2,4" />
                <Path Data="M324.8,136.7 L323.5,142.2 L347.3,156.2 L341.1,168.3 L315.9,157.3 L312.1,161.5 L307.9,165.2 L318.9,190.5 L306.8,196.6 L292.9,172.9 L287.3,174.1 L281.7,174.7 L275.8,201.5 L262.4,199.4 L265.1,172.0 L259.9,169.8 L255.0,166.9 L234.4,185.2 L224.8,175.6 L243.1,155.0 L240.2,150.1 L238.0,144.9 L210.6,147.6 L208.5,134.2 L235.3,128.3 L235.9,122.7 L237.1,117.1 L213.4,103.2 L219.5,91.1 L244.8,102.1 L248.5,97.9 L252.7,94.1 L241.7,68.9 L253.8,62.7 L267.8,86.5 L273.3,85.2 L278.9,84.7 L284.8,57.8 L298.2,60.0 L295.6,87.4 L300.7,89.6 L305.6,92.5 L326.2,74.2 L335.8,83.8 L317.5,104.4 L320.4,109.3 L322.6,114.4 L350.0,111.8 L352.2,125.2 L325.3,131.1 Z" Stroke="#7FB3D5" StrokeThickness="1" />
                <Ellipse Canvas.Left="267.3" Canvas.Top="116.7" Width="26" Height="26" Stroke="#7FB3D5" StrokeThickness="1" />
                <!-- Their pitch circles, touching where the teeth mesh. -->
                <Ellipse Canvas.Left="74.0" Canvas.Top="144.0" Width="192" Height="192" Stroke="#E9C46A" StrokeThickness="1" StrokeDashArray="4,6" />
                <Ellipse Canvas.Left="220.3" Canvas.Top="69.7" Width="120" Height="120" Stroke="#7FB3D5" StrokeThickness="1" StrokeDashArray="4,6" />
            </Canvas>
        </Viewbox>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="40" MaxWidth="460">
            <TextBlock Classes="coverTitle" Text="{loc:Localize Book_Title}" />
            <TextBlock Classes="coverText" Text="{loc:Localize Book_Subtitle}" />
            <TextBlock Classes="coverText" Opacity="0.75" FontSize="14" Text="{loc:Localize Cover_Tagline}" />
            <Button Classes="coverOpen" Margin="0,18,0,0"
                    Content="{loc:Localize Cover_Open}"
                    Command="{Binding OpenCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
