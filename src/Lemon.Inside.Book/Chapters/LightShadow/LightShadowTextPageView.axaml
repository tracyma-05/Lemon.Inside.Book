<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:light="using:Lemon.Inside.Book.Chapters.LightShadow"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.LightShadow.LightShadowTextPageView"
                              x:DataType="light:LightShadowTextPageViewModel">
    <!-- A left page of the Light and shadow chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="light:BrightnessSpread">
                            <StackPanel>
                                <DockPanel Margin="0,12,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding PowerText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Brightness_Power}" />
                                </DockPanel>
                                <Slider Minimum="2" Maximum="150" Value="{Binding Power}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Light_Brightness_Power}" />
                                <SelectableTextBlock Classes="note" Text="{loc:Localize Light_DragHint}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:TiltSpread">
                            <StackPanel>
                                <DockPanel Margin="0,12,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TiltText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Tilt_Angle}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="85" Value="{Binding Tilt}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Light_Tilt_Angle}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:DistanceSpread">
                            <StackPanel>
                                <DockPanel Margin="0,12,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DistanceText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Distance_Slider}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="4" Value="{Binding Distance}" SmallChange="0.1" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Light_Distance_Slider}" />
                                <SelectableTextBlock Classes="note" Text="{loc:Localize Light_DragHint}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:AngleSpread">
                            <StackPanel>
                                <DockPanel Margin="0,12,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DistanceText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Angle_Slider}" />
                                </DockPanel>
                                <Slider Minimum="3" Maximum="40" Value="{Binding Distance}" SmallChange="0.5" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Light_Angle_Slider}" />
                                <SelectableTextBlock Classes="note" Text="{Binding AngleText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:SkySpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding ElevationText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Sky_Elevation}" />
                                </DockPanel>
                                <Slider Minimum="5" Maximum="90" Value="{Binding Elevation}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Light_Sky_Elevation}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DistanceText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Sky_Distance}" />
                                </DockPanel>
                                <Slider Minimum="1.6" Maximum="5" Value="{Binding Distance}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Light_Sky_Distance}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ShareText}" />
                                <SelectableTextBlock Classes="note" Text="{loc:Localize Light_DragHint}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:RadianceSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DistanceText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Radiance_Distance}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="6" Value="{Binding Distance}" SmallChange="0.1" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Light_Radiance_Distance}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TiltText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Radiance_Tilt}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="80" Value="{Binding Tilt}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Light_Radiance_Tilt}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:ReflectionSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LightAngleText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Reflection_Light}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="80" Value="{Binding LightAngle}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Light_Reflection_Light}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding RoughnessText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Reflection_Roughness}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Roughness}" SmallChange="0.02" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Light_Reflection_Roughness}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding EyeAngleText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Reflection_Eye}" />
                                </DockPanel>
                                <Slider Minimum="-80" Maximum="80" Value="{Binding EyeAngle}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Light_Reflection_Eye}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:BounceSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding BouncesText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Bounce_Count}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="3" Value="{Binding Bounces}" SmallChange="1" LargeChange="1"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Light_Bounce_Count}" />
                                <SelectableTextBlock Classes="caption" Margin="0,10,0,2" Text="{loc:Localize Light_Bounce_Wall}" />
                                <WrapPanel>
                                    <RadioButton Classes="chip" GroupName="LightWall" IsChecked="{Binding IsRed}" Content="{loc:Localize Light_Bounce_Red}" />
                                    <RadioButton Classes="chip" GroupName="LightWall" IsChecked="{Binding IsGreen}" Content="{loc:Localize Light_Bounce_Green}" />
                                    <RadioButton Classes="chip" GroupName="LightWall" IsChecked="{Binding IsBlue}" Content="{loc:Localize Light_Bounce_Blue}" />
                                </WrapPanel>
                                <SelectableTextBlock Classes="note" Text="{loc:Localize Light_DragHint}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="light:ShadowSpread">
                            <StackPanel>
                                <DockPanel Margin="0,12,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LightHeightText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Height}" />
                                </DockPanel>
                                <Slider Minimum="1.2" Maximum="4" Value="{Binding LightHeight}" SmallChange="0.05" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Light_Height}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LightSizeText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Size}" />
                                </DockPanel>
                                <Slider Minimum="0.05" Maximum="2" Value="{Binding LightSize}" SmallChange="0.05" LargeChange="0.25"
                                        AutomationProperties.Name="{loc:Localize Light_Size}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LightXText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Position}" />
                                </DockPanel>
                                <Slider Minimum="-2" Maximum="2" Value="{Binding LightX}" SmallChange="0.05" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Light_Position}" />
                                <SelectableTextBlock Classes="note" Text="{loc:Localize Light_DragHint}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
