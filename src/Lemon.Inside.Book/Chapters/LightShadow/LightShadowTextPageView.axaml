<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:light="using:Lemon.Inside.Book.Chapters.LightShadow"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.LightShadow.LightShadowTextPageView"
                              x:DataType="light:LightShadowTextPageViewModel">
    <!-- Left page of the Light and shadow spread: what the picture shows, the lamp's settings and (P0) the renderer's. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,8" Text="{Binding Title}" />

                <SelectableTextBlock Classes="text" FontSize="18" LineHeight="27" Text="{loc:Localize Light_Intro}" />
                <SelectableTextBlock Classes="note" Margin="0,6,0,0" Text="{loc:Localize Light_DragHint}" />

                <DockPanel Margin="0,16,0,2">
                    <SelectableTextBlock Classes="value" Text="{Binding Light.LightHeightText}" />
                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Height}" />
                </DockPanel>
                <Slider Minimum="1.2" Maximum="4" Value="{Binding Light.LightHeight}" SmallChange="0.05" LargeChange="0.5"
                        AutomationProperties.Name="{loc:Localize Light_Height}" />

                <DockPanel Margin="0,10,0,2">
                    <SelectableTextBlock Classes="value" Text="{Binding Light.LightSizeText}" />
                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Size}" />
                </DockPanel>
                <Slider Minimum="0.02" Maximum="2" Value="{Binding Light.LightSize}" SmallChange="0.02" LargeChange="0.25"
                        AutomationProperties.Name="{loc:Localize Light_Size}" />

                <DockPanel Margin="0,10,0,2">
                    <SelectableTextBlock Classes="value" Text="{Binding Light.LightXText}" />
                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Position}" />
                </DockPanel>
                <Slider Minimum="-2" Maximum="2" Value="{Binding Light.LightX}" SmallChange="0.05" LargeChange="0.5"
                        AutomationProperties.Name="{loc:Localize Light_Position}" />

                <!-- P0 spike: the renderer's own settings, to measure what the browser and the desktop can do. -->
                <SelectableTextBlock Classes="caption" Margin="0,22,0,0" Text="{loc:Localize Light_Spike_Title}" />
                <SelectableTextBlock Classes="note" Text="{loc:Localize Light_Spike_Note}" />

                <DockPanel Margin="0,10,0,2">
                    <SelectableTextBlock Classes="value" Text="{Binding Light.SamplesText}" />
                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Samples}" />
                </DockPanel>
                <Slider Minimum="1" Maximum="24" Value="{Binding Light.Samples}" SmallChange="1" LargeChange="4"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        AutomationProperties.Name="{loc:Localize Light_Samples}" />

                <DockPanel Margin="0,10,0,2">
                    <SelectableTextBlock Classes="value" Text="{Binding Light.RenderScaleText}" />
                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Light_Resolution}" />
                </DockPanel>
                <Slider Minimum="0.25" Maximum="1" Value="{Binding Light.RenderScale}" SmallChange="0.05" LargeChange="0.25"
                        AutomationProperties.Name="{loc:Localize Light_Resolution}" />

                <WrapPanel Margin="0,8,0,0">
                    <ToggleButton Classes="chip" IsChecked="{Binding Light.Spin}" Content="{loc:Localize Light_Spin}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
