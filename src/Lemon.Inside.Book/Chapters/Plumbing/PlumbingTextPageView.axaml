<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:plumbing="using:Lemon.Inside.Book.Chapters.Plumbing"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Plumbing.PlumbingTextPageView"
                              x:DataType="plumbing:PlumbingTextPageViewModel">
    <!-- A left page of the Plumbing chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="plumbing:TowerSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding SurfaceText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Tower_Surface}" />
                                </DockPanel>
                                <Slider Minimum="15" Maximum="40" Value="{Binding Surface}" SmallChange="0.5" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Plumbing_Tower_Surface}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TapHeightText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Tower_TapHeight}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="37" Value="{Binding TapHeight}" SmallChange="1" LargeChange="3"
                                        AutomationProperties.Name="{loc:Localize Plumbing_Tower_TapHeight}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="plumbing:TapSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TurnsText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Tap_Turns}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="3" Value="{Binding Turns}" SmallChange="0.05" LargeChange="0.25"
                                        AutomationProperties.Name="{loc:Localize Plumbing_Tap_Turns}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Worn}" Content="{loc:Localize Plumbing_Tap_Worn}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="plumbing:SiphonSpread">
                            <StackPanel>
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Primed}" Content="{loc:Localize Plumbing_Siphon_Primed}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding OutletText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Siphon_Outlet}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="3" Value="{Binding Outlet}" SmallChange="0.05" LargeChange="0.25"
                                        AutomationProperties.Name="{loc:Localize Plumbing_Siphon_Outlet}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="plumbing:CisternSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding SetText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Cistern_Set}" />
                                </DockPanel>
                                <Slider Minimum="20" Maximum="38" Value="{Binding Set}" SmallChange="0.5" LargeChange="2"
                                        AutomationProperties.Name="{loc:Localize Plumbing_Cistern_Set}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Flushing}" Content="{loc:Localize Plumbing_Cistern_Flush}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="plumbing:TrapSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding SuctionText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Trap_Suction}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="12" Value="{Binding Suction}" SmallChange="0.25" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Plumbing_Trap_Suction}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Vent}" Content="{loc:Localize Plumbing_Trap_Vent}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="plumbing:PumpSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DepthText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Plumbing_Pump_Depth}" />
                                </DockPanel>
                                <Slider Minimum="2" Maximum="14" Value="{Binding Depth}" SmallChange="0.25" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Plumbing_Pump_Depth}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Down}" Content="{loc:Localize Plumbing_Pump_Down}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
