<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:car="using:Lemon.Inside.Book.Chapters.Car"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Car.CarTextPageView"
                              x:DataType="car:CarTextPageViewModel">
    <!-- A left page of the Car chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="car:CrankSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding RodText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Crank_Rod}" />
                                </DockPanel>
                                <Slider Minimum="1.5" Maximum="5" Value="{Binding Rod}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Car_Crank_Rod}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="car:CamSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LiftText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Cam_Lift}" />
                                </DockPanel>
                                <Slider Minimum="4" Maximum="12" Value="{Binding Lift}" SmallChange="0.5" LargeChange="2"
                                        AutomationProperties.Name="{loc:Localize Car_Cam_Lift}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DurationText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Cam_Duration}" />
                                </DockPanel>
                                <Slider Minimum="180" Maximum="300" Value="{Binding Duration}" SmallChange="5" LargeChange="20"
                                        AutomationProperties.Name="{loc:Localize Car_Cam_Duration}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="car:CylindersSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding CountText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Cylinders_Count}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="5" Value="{Binding CountStep}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Car_Cylinders_Count}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding FlywheelText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Cylinders_Flywheel}" />
                                </DockPanel>
                                <Slider Minimum="0.2" Maximum="3" Value="{Binding Flywheel}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Car_Cylinders_Flywheel}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="car:ClutchSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding PedalText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Clutch_Pedal}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Pedal}" SmallChange="0.02" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Car_Clutch_Pedal}" />
                                <SelectableTextBlock Classes="note" Text="{loc:Localize Car_Clutch_Hint}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="car:BendSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding RadiusText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Bend_Radius}" />
                                </DockPanel>
                                <Slider Minimum="4" Maximum="40" Value="{Binding Radius}" SmallChange="0.5" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Car_Bend_Radius}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="car:IceSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding GripText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Car_Ice_Grip}" />
                                </DockPanel>
                                <Slider Minimum="0.05" Maximum="0.8" Value="{Binding LeftGrip}" SmallChange="0.01" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Car_Ice_Grip}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Locked}" Content="{loc:Localize Car_Ice_Lock}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
