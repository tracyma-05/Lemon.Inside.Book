<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:gps="using:Lemon.Inside.Book.Chapters.Gps"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Gps.GpsTextPageView"
                              x:DataType="gps:GpsTextPageViewModel">
    <!-- A left page of the Gps chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="gps:EchoSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DelayText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Echo_Delay}" />
                                </DockPanel>
                                <Slider Minimum="60" Maximum="90" Value="{Binding Delay}" SmallChange="0.1" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Gps_Echo_Delay}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="gps:FixSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding CountText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Fix_Count}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="3" Value="{Binding Count}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Gps_Fix_Count}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding EastText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Fix_East}" />
                                </DockPanel>
                                <Slider Minimum="-200" Maximum="200" Value="{Binding East}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Gps_Fix_East}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding NorthText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Fix_North}" />
                                </DockPanel>
                                <Slider Minimum="-200" Maximum="200" Value="{Binding North}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Gps_Fix_North}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="gps:ClockSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding OffsetText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Clock_Offset}" />
                                </DockPanel>
                                <Slider Minimum="-200" Maximum="200" Value="{Binding Offset}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Gps_Clock_Offset}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="gps:DriftSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DaysText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Drift_Days}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="7" Value="{Binding Days}" SmallChange="0.1" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Gps_Drift_Days}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Corrected}" Content="{loc:Localize Gps_Drift_CorrectedLabel}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="gps:OrbitSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding AltitudeText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Orbit_Height}" />
                                </DockPanel>
                                <Slider Minimum="400" Maximum="36000" Value="{Binding Altitude}" SmallChange="100" LargeChange="1000"
                                        AutomationProperties.Name="{loc:Localize Gps_Orbit_Height}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="gps:AngleSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding AngleText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Angle_Angle}" />
                                </DockPanel>
                                <Slider Minimum="5" Maximum="175" Value="{Binding Angle}" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Gps_Angle_Angle}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding ErrorText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Gps_Angle_Error}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="10" Value="{Binding Error}" SmallChange="0.5" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Gps_Angle_Error}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
