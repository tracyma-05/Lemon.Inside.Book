<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:tesseract="using:Lemon.Inside.Book.Chapters.Tesseract"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Tesseract.TesseractTextPageView"
                              x:DataType="tesseract:TesseractTextPageViewModel">
    <!-- A left page of the Tesseract chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="tesseract:BuildSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DimensionText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Build_Dimension}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="4" Value="{Binding Dimension}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Build_Dimension}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding SlideText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Build_Slide}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Slide}" SmallChange="0.01" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Build_Slide}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="tesseract:ShadowSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TurnText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Shadow_Turn}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="90" Value="{Binding Turn}" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Shadow_Turn}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TiltText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Shadow_Tilt}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="90" Value="{Binding Tilt}" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Shadow_Tilt}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="tesseract:NestedSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DistanceText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Nested_Distance}" />
                                </DockPanel>
                                <Slider Minimum="1.2" Maximum="5" Value="{Binding Distance}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Nested_Distance}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TurnText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Nested_Turn}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="360" Value="{Binding Turn}" SmallChange="1" LargeChange="15"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Nested_Turn}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="tesseract:SpinSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding AngleText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Spin_Angle}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="360" Value="{Binding Angle}" SmallChange="1" LargeChange="15"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Spin_Angle}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Both}" Content="{loc:Localize Tesseract_Spin_BothLabel}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="tesseract:SliceSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DepthText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Slice_Depth}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Depth}" SmallChange="0.01" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Slice_Depth}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding CornerFirst}" Content="{loc:Localize Tesseract_Slice_CornerFirst}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="tesseract:NetSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding FoldText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Net_Fold}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Fold}" SmallChange="0.01" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Net_Fold}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding ChosenText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Tesseract_Net_Chosen}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="7" Value="{Binding Chosen}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Tesseract_Net_Chosen}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
