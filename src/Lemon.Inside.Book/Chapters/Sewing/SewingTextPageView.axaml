<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:sewing="using:Lemon.Inside.Book.Chapters.Sewing"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Sewing.SewingTextPageView"
                              x:DataType="sewing:SewingTextPageViewModel">
    <!-- A left page of the Sewing chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="sewing:StitchSpread">
                            <StackPanel>
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Chain}" Content="{loc:Localize Sewing_Stitch_Chain}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LengthText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Length}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="5" Value="{Binding Length}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Sewing_Length}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Pulled}" Content="{loc:Localize Sewing_Stitch_Pull}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="sewing:NeedleSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding AngleText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Needle_Angle}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="360" Value="{Binding Angle}" SmallChange="1" LargeChange="15"
                                        AutomationProperties.Name="{loc:Localize Sewing_Needle_Angle}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding HandNeedle}" Content="{loc:Localize Sewing_Needle_Hand}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="sewing:HookSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding TimingText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Hook_Timing}" />
                                </DockPanel>
                                <Slider Minimum="-30" Maximum="30" Value="{Binding Timing}" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Sewing_Hook_Timing}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="sewing:TakeUpSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LengthText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Length}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="5" Value="{Binding Length}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Sewing_Length}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Held}" Content="{loc:Localize Sewing_TakeUp_Hold}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="sewing:FeedSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding LengthText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Length}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="5" Value="{Binding Length}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Sewing_Length}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Reverse}" Content="{loc:Localize Sewing_Feed_Reverse}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="sewing:TensionSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DialText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Tension_Dial}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="9" Value="{Binding Dial}" SmallChange="0.5" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Sewing_Tension_Dial}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding BobbinText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Sewing_Tension_Bobbin}" />
                                </DockPanel>
                                <Slider Minimum="15" Maximum="45" Value="{Binding Bobbin}" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Sewing_Tension_Bobbin}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
