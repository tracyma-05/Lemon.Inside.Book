<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:lifting="using:Lemon.Inside.Book.Chapters.Lifting"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Lifting.LiftingTextPageView"
                              x:DataType="lifting:LiftingTextPageViewModel">
    <!-- A left page of the Lifting chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="lifting:SeesawSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding PivotText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Seesaw_Pivot}" />
                                </DockPanel>
                                <Slider Minimum="0.6" Maximum="2" Value="{Binding Pivot}" SmallChange="0.05" LargeChange="0.2" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Seesaw_Pivot}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding PushText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Seesaw_Push}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Push}" SmallChange="0.02" LargeChange="0.1" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Seesaw_Push}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="lifting:PulleySpread">
                            <StackPanel>
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Moving}" Content="{loc:Localize Lifting_Pulley_Moving}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding PullText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Pulley_Pull}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="2" Value="{Binding Pull}" SmallChange="0.05" LargeChange="0.25" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Pulley_Pull}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="lifting:TackleSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding StrandsText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Tackle_Strands}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="6" Value="{Binding Strands}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Tackle_Strands}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Friction}" Content="{loc:Localize Lifting_Tackle_Friction}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding PullText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Tackle_Pull}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="2" Value="{Binding Pull}" SmallChange="0.05" LargeChange="0.25" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Tackle_Pull}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="lifting:WinchSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding HandleText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Winch_Handle}" />
                                </DockPanel>
                                <Slider Minimum="0.1" Maximum="0.5" Value="{Binding Handle}" SmallChange="0.01" LargeChange="0.05" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Winch_Handle}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Worm}" Content="{loc:Localize Lifting_Winch_Worm}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding LetGo}" Content="{loc:Localize Lifting_Winch_LetGo}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="lifting:JackSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding RamText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Jack_Ram}" />
                                </DockPanel>
                                <Slider Minimum="2" Maximum="10" Value="{Binding Ram}" SmallChange="0.5" LargeChange="1" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Jack_Ram}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding StrokesText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Jack_Strokes}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="40" Value="{Binding Strokes}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Jack_Strokes}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="lifting:ElevatorSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding RidersText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Lifting_Elevator_Riders}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="13" Value="{Binding Riders}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" 
                                        AutomationProperties.Name="{loc:Localize Lifting_Elevator_Riders}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Counterweight}" Content="{loc:Localize Lifting_Elevator_Counter}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
