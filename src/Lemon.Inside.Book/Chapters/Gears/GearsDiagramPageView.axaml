<explore:ChapterPageView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:gears="using:Lemon.Inside.Book.Chapters.Gears"
                         xmlns:explore="using:Lemon.Book.Shell.Controls.Explore"
                         xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                         x:Class="Lemon.Inside.Book.Chapters.Gears.GearsDiagramPageView"
                         x:DataType="gears:GearsDiagramPageViewModel">
    <!-- A right page of the Gears chapter: the spread's moving picture on a dark plate. -->
    <Grid RowDefinitions="*,Auto" Margin="28,28,28,20">
        <Border Classes="plate" CornerRadius="12" ClipToBounds="True">
            <Grid>
                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="gears:RatioSpread">
                            <gears:RatioDiagram Highlight="{Binding Lesson.Highlight}" SelectedPart="{Binding Card.Id}" PartNames="{Binding PartNames}"
                                     DriverTeeth="{Binding DriverTeeth}" DrivenTeeth="{Binding DrivenTeeth}"
                                                AutomationProperties.Name="{loc:Localize Gears_Ratio_Picture}" />
                        </DataTemplate>
                        <DataTemplate DataType="gears:TorqueSpread">
                            <gears:TorqueDiagram Highlight="{Binding Lesson.Highlight}" SelectedPart="{Binding Card.Id}" PartNames="{Binding PartNames}"
                                     DrivenTeeth="{Binding DrivenTeeth}" AutomationProperties.Name="{loc:Localize Gears_Torque_Picture}" />
                        </DataTemplate>
                        <DataTemplate DataType="gears:InvoluteSpread">
                            <gears:InvoluteDiagram Highlight="{Binding Lesson.Highlight}" SelectedPart="{Binding Card.Id}" PartNames="{Binding PartNames}"
                                     Unwound="{Binding Unwound}" AutomationProperties.Name="{loc:Localize Gears_Involute_Picture}" />
                        </DataTemplate>
                        <DataTemplate DataType="gears:MeshSpread">
                            <gears:MeshDiagram Highlight="{Binding Lesson.Highlight}" SelectedPart="{Binding Card.Id}" PartNames="{Binding PartNames}"
                                     PressureAngle="{Binding PressureAngle}" Speed="{Binding Speed}"
                                               AutomationProperties.Name="{loc:Localize Gears_Mesh_Picture}" />
                        </DataTemplate>
                        <DataTemplate DataType="gears:TrainSpread">
                            <gears:TrainDiagram Highlight="{Binding Lesson.Highlight}" SelectedPart="{Binding Card.Id}" PartNames="{Binding PartNames}"
                                     Steps="{Binding Steps}" AutomationProperties.Name="{loc:Localize Gears_Train_Picture}" />
                        </DataTemplate>
                        <DataTemplate DataType="gears:PlanetarySpread">
                            <gears:PlanetaryDiagram Highlight="{Binding Lesson.Highlight}" SelectedPart="{Binding Card.Id}" PartNames="{Binding PartNames}"
                                     SunStep="{Binding SunStep}" Held="{Binding Held}"
                                                    AutomationProperties.Name="{loc:Localize Gears_Planet_Picture}" />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>

                <!-- The spoken walkthrough: started from the corner, its subtitles and controls along the bottom. -->
                <ToggleButton Classes="space" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                              IsChecked="{Binding Spread.Lesson.IsActive, Mode=OneWay}"
                              Command="{Binding Spread.Lesson.ToggleCommand}"
                              ToolTip.Tip="{loc:Localize Lesson_Start_Tooltip}"
                              AutomationProperties.Name="{loc:Localize Lesson_Start}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Voice}" />
                        <TextBlock Text="{loc:Localize Lesson_Start}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <explore:LessonPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     DataContext="{Binding Spread.Lesson}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</explore:ChapterPageView>
