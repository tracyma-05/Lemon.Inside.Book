<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:locks="using:Lemon.Inside.Book.Chapters.Locks"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Locks.LocksTextPageView"
                              x:DataType="locks:LocksTextPageViewModel">
    <!-- A left page of the Locks chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="locks:PinsSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding InsertText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Pins_Insert}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Insert}" SmallChange="0.02" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Locks_Pins_Insert}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Wrong}" Content="{loc:Localize Locks_Pins_Wrong}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="locks:KeysSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding CutsText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Keys_Cuts}" />
                                </DockPanel>
                                <Slider Minimum="3" Maximum="7" Value="{Binding Cuts}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Keys_Cuts}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DepthsText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Keys_Depths}" />
                                </DockPanel>
                                <Slider Minimum="4" Maximum="10" Value="{Binding Depths}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Keys_Depths}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding SteepestText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Keys_Steepest}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="{Binding MostSteep}" Value="{Binding Steepest}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Keys_Steepest}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="locks:MasterSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding KeyText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Master_Which}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="3" Value="{Binding KeyChoice}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Master_Which}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="locks:BindingSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding SetText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Binding_Set}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="5" Value="{Binding Set}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Binding_Set}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Perfect}" Content="{loc:Localize Locks_Binding_Perfect}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="locks:LeverSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding AngleText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Lever_Angle}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="180" Value="{Binding Angle}" SmallChange="2" LargeChange="15"
                                        AutomationProperties.Name="{loc:Localize Locks_Lever_Angle}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Wrong}" Content="{loc:Localize Locks_Lever_Wrong}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="locks:DialsSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding FirstText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Dials_First}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="9" Value="{Binding First}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Dials_First}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding SecondText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Dials_Second}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="9" Value="{Binding Second}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Dials_Second}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding ThirdText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Locks_Dials_Third}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="9" Value="{Binding Third}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="{loc:Localize Locks_Dials_Third}" />
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding Sloppy}" Content="{loc:Localize Locks_Dials_Sloppy}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
