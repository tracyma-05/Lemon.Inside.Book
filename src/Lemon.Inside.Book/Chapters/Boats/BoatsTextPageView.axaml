<shellExplore:ChapterPageView xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:boats="using:Lemon.Inside.Book.Chapters.Boats"
                              xmlns:shellExplore="using:Lemon.Book.Shell.Controls.Explore"
                              xmlns:exploreControls="using:Lemon.Inside.Book.Controls.Explore"
                              xmlns:loc="using:Lemon.Book.Shell.Infrastructures.Localization"
                              x:Class="Lemon.Inside.Book.Chapters.Boats.BoatsTextPageView"
                              x:DataType="boats:BoatsTextPageViewModel">
    <!-- A left page of the Boats chapter: the spread's words, a closer look, and its picture's settings. -->
    <shellExplore:ChapterPageView.Styles>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector=":is(TextBlock).spreadTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </shellExplore:ChapterPageView.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="44,32,40,20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <StackPanel>
                <!-- The chapter's first spread opens it; the others say where they are in it. -->
                <StackPanel IsVisible="{Binding IsFirstSpread}">
                    <SelectableTextBlock Classes="kicker" Text="{Binding VolumeTitle}" />
                    <SelectableTextBlock Classes="chapterNumber" Margin="0,12,0,0" Text="{Binding NumberLabel}" />
                    <SelectableTextBlock Classes="pageTitle" Margin="0,4,0,14" Text="{Binding Title}" />
                </StackPanel>
                <SelectableTextBlock Classes="kicker" Text="{Binding SpreadLabel}" />
                <SelectableTextBlock Classes="spreadTitle" Margin="0,6,0,10" Text="{Binding Spread.Title}" />

                <ItemsControl ItemsSource="{Binding Spread.Paragraphs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Classes="text" FontSize="17" LineHeight="26" Margin="0,0,0,10" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,4,0,6" Padding="14,10" CornerRadius="8" Background="{DynamicResource AccentFaintBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                    <StackPanel>
                        <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Deeper}" />
                        <SelectableTextBlock Classes="note" Margin="0,4,0,0" Text="{Binding Spread.Deeper}" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Spread}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="boats:FloatSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DensityText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Float_Density}" />
                                </DockPanel>
                                <Slider Minimum="100" Maximum="2000" Value="{Binding Density}" SmallChange="10" LargeChange="100"
                                        AutomationProperties.Name="{loc:Localize Boats_Float_Density}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="boats:PressureSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding DepthText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Pressure_Depth}" />
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="10" Value="{Binding Depth}" SmallChange="0.1" LargeChange="1"
                                        AutomationProperties.Name="{loc:Localize Boats_Pressure_Depth}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="boats:HullSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding CargoText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Hull_Cargo}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="80" Value="{Binding Cargo}" SmallChange="1" LargeChange="10"
                                        AutomationProperties.Name="{loc:Localize Boats_Hull_Cargo}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="boats:HeelSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding HeelText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Heel_Angle}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="60" Value="{Binding HeelAngle}" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="{loc:Localize Boats_Heel_Angle}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="boats:StabilitySpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding HeightText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Stability_Height}" />
                                </DockPanel>
                                <Slider Minimum="1" Maximum="4" Value="{Binding CentreHeight}" SmallChange="0.05" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Boats_Stability_Height}" />
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding BeamText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Stability_Beam}" />
                                </DockPanel>
                                <Slider Minimum="4" Maximum="8" Value="{Binding Beam}" SmallChange="0.1" LargeChange="0.5"
                                        AutomationProperties.Name="{loc:Localize Boats_Stability_Beam}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="boats:SubmarineSpread">
                            <StackPanel>
                                <DockPanel Margin="0,10,0,2">
                                    <SelectableTextBlock Classes="value" Text="{Binding BallastText}" />
                                    <SelectableTextBlock Classes="caption" Margin="0" Text="{loc:Localize Boats_Submarine_Ballast}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Ballast}" SmallChange="0.01" LargeChange="0.1"
                                        AutomationProperties.Name="{loc:Localize Boats_Submarine_Ballast}" />
                                <SelectableTextBlock Classes="note" Text="{Binding ReadoutText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The part last clicked in the picture, and what it is: kept in view under the scrolling words. -->
        <exploreControls:ObjectCardView Grid.Row="1" Margin="0,10,14,0" DataContext="{Binding Spread.Card}" />

        <TextBlock Grid.Row="2" Classes="folio" Text="{Binding Folio}" HorizontalAlignment="{Binding FolioAlignment}" />
    </Grid>
</shellExplore:ChapterPageView>
