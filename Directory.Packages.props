<Project>
  <!--
    Central Package Management: PackageReference items omit Version and resolve it here.
    Released versions only, and keep every Avalonia package on the same version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Avalonia">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
  </ItemGroup>
  <ItemGroup Label="WebAssembly native graphics">
    <!--
      The web head only. .NET 11 links WebAssembly with Emscripten 6.0.2; Avalonia 12.1.x still brings SkiaSharp 3.119.4,
      whose native archive is built for Emscripten 3.1.56 and no longer links (undefined saveSetjmp/testSetjmp).
      SkiaSharp has 6.0.2 archives from 4.156.0, HarfBuzzSharp from 14.4.0.100. Drop these once Avalonia brings them
      itself.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.156.0" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.4.0.100" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.4.0.100" />
  </ItemGroup>
  <ItemGroup Label="Application">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The shell every Lemon book shares (Lemon.Book.Shell): the book, narration, lessons, settings, updates. -->
    <PackageVersion Include="Lemon.Book.Shell" Version="0.3.0" />
    <PackageVersion Include="Lemon.Book.Shell.Browser" Version="0.3.0" />
    <PackageVersion Include="Lemon.Book.Shell.Desktop" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Avalonia.Headless.XUnit 12 is built on xunit v3 (3.x): xunit 4 breaks its [AvaloniaFact] discovery. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>