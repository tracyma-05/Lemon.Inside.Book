{
 "en": {
  "clips": {
   "Narr_Common_MoveOn": {
    "duration": 3.168,
    "hash": "7f92fcf16bdadd37",
    "sentences": [
     [
      0.05,
      1.262,
      "Let's keep going."
     ],
     [
      1.262,
      3.097,
      "You can try it again later."
     ]
    ]
   },
   "Narr_Common_Nice": {
    "duration": 1.392,
    "hash": "a3569dde74fd8612",
    "sentences": [
     [
      0.05,
      1.333,
      "Nicely done!"
     ]
    ]
   },
   "Narr_Common_Reveal": {
    "duration": 2.952,
    "hash": "06e6be56b7074765",
    "sentences": [
     [
      0.05,
      1.208,
      "Time's up!"
     ],
     [
      1.208,
      2.903,
      "Here's the right answer."
     ]
    ]
   },
   "Narr_Common_Right": {
    "duration": 1.32,
    "hash": "24bca8c4c340ebc6",
    "sentences": [
     [
      0.05,
      1.25,
      "That's right!"
     ]
    ]
   },
   "Narr_Common_Wrong": {
    "duration": 3.096,
    "hash": "b923348234623eba",
    "sentences": [
     [
      0.05,
      1.375,
      "Not quite."
     ],
     [
      1.375,
      3.028,
      "Let's look at the answer."
     ]
    ]
   },
   "Narr_Gears_Involute_01": {
    "duration": 4.68,
    "hash": "95975c9c883975ce",
    "sentences": [
     [
      0.05,
      4.611,
      "A string wound round a can, with a pencil tied to its end."
     ]
    ]
   },
   "Narr_Gears_Involute_02": {
    "duration": 6.384,
    "hash": "b30bd7f8ded6926b",
    "sentences": [
     [
      0.05,
      6.333,
      "Your turn: unwind the string at least halfway round and watch the curve the pencil draws."
     ]
    ]
   },
   "Narr_Gears_Involute_03": {
    "duration": 7.368,
    "hash": "84e33ed07237f517",
    "sentences": [
     [
      0.05,
      3.889,
      "The tight string always meets the curve at a right angle."
     ],
     [
      3.889,
      7.306,
      "That is the curve on both sides of a good gear tooth."
     ]
    ]
   },
   "Narr_Gears_Involute_04": {
    "duration": 6.504,
    "hash": "bb91ecfaa288c95c",
    "sentences": [
     [
      0.05,
      6.431,
      "With this shape, two teeth always push along one straight line, so the gears turn smoothly."
     ]
    ]
   },
   "Narr_Gears_Mesh_01": {
    "duration": 5.136,
    "hash": "77a02ebdf7562928",
    "sentences": [
     [
      0.05,
      2.111,
      "The gears turn slowly."
     ],
     [
      2.111,
      5.083,
      "Watch the gold dot where two teeth touch."
     ]
    ]
   },
   "Narr_Gears_Mesh_02": {
    "duration": 5.928,
    "hash": "22d6a3c78a94eb86",
    "sentences": [
     [
      0.05,
      5.861,
      "The dot slides along one slanted line, from where the teeth meet to where they let go."
     ]
    ]
   },
   "Narr_Gears_Mesh_03": {
    "duration": 7.752,
    "hash": "9d67acf314de0660",
    "sentences": [
     [
      0.05,
      1.25,
      "Speed it up."
     ],
     [
      1.25,
      7.681,
      "Before one pair lets go, the next pair has already met, so the push never stops."
     ]
    ]
   },
   "Narr_Gears_Mesh_04": {
    "duration": 4.704,
    "hash": "3ccbb22020c04599",
    "sentences": [
     [
      0.05,
      4.653,
      "Your turn: make the pressure angle bigger and look at the teeth."
     ]
    ]
   },
   "Narr_Gears_Mesh_05": {
    "duration": 2.832,
    "hash": "594d6e8ebfdee7a5",
    "sentences": [
     [
      0.05,
      2.778,
      "What does a bigger pressure angle give the teeth?"
     ]
    ]
   },
   "Narr_Gears_Planet_01": {
    "duration": 8.208,
    "hash": "f792be9444df3c23",
    "sentences": [
     [
      0.05,
      1.958,
      "The ring is held still."
     ],
     [
      1.958,
      8.139,
      "Turn the sun, and the planets roll round it, taking the carrier slowly with them."
     ]
    ]
   },
   "Narr_Gears_Planet_02": {
    "duration": 5.496,
    "hash": "68e4710f5500d208",
    "sentences": [
     [
      0.05,
      5.444,
      "That is a big slowing in a small space, with no gear sticking out to the side."
     ]
    ]
   },
   "Narr_Gears_Planet_03": {
    "duration": 5.592,
    "hash": "3f32ed4192e9000b",
    "sentences": [
     [
      0.05,
      5.528,
      "Your turn: hold the carrier instead, and watch which way the ring turns."
     ]
    ]
   },
   "Narr_Gears_Planet_04": {
    "duration": 4.704,
    "hash": "c0afb4326f65acb1",
    "sentences": [
     [
      0.05,
      1.861,
      "Now the sun is held."
     ],
     [
      1.861,
      4.639,
      "The same gears give yet another speed."
     ]
    ]
   },
   "Narr_Gears_Planet_05": {
    "duration": 3.192,
    "hash": "beb103fe5ee1f7b2",
    "sentences": [
     [
      0.05,
      3.125,
      "How does a gearbox like this change its speed?"
     ]
    ]
   },
   "Narr_Gears_Ratio_01": {
    "duration": 6.624,
    "hash": "beab28abc39e7a7e",
    "sentences": [
     [
      0.05,
      6.569,
      "Two gears with the same number of teeth: they turn at the same speed, in opposite directions."
     ]
    ]
   },
   "Narr_Gears_Ratio_02": {
    "duration": 7.152,
    "hash": "a7ee3303e93bf762",
    "sentences": [
     [
      0.05,
      2.722,
      "Give the right gear twice the teeth."
     ],
     [
      2.722,
      7.083,
      "Now it turns once for every two turns of the small one."
     ]
    ]
   },
   "Narr_Gears_Ratio_03": {
    "duration": 5.808,
    "hash": "31d39d1e16ef165b",
    "sentences": [
     [
      0.05,
      5.75,
      "Your turn: give the driven gear three times as many teeth as the driver."
     ]
    ]
   },
   "Narr_Gears_Ratio_04": {
    "duration": 6.984,
    "hash": "fd8c1d4b1e51893b",
    "sentences": [
     [
      0.05,
      3.292,
      "A ten-tooth gear drives a thirty-tooth gear."
     ],
     [
      3.292,
      6.917,
      "One turn of the small gear turns the big one how far?"
     ]
    ]
   },
   "Narr_Gears_Torque_01": {
    "duration": 4.944,
    "hash": "05aff503dcd3c876",
    "sentences": [
     [
      0.05,
      4.875,
      "The crank turns a small gear, and the small gear turns the drum's big gear."
     ]
    ]
   },
   "Narr_Gears_Torque_02": {
    "duration": 4.248,
    "hash": "61c1fff5ff378ce0",
    "sentences": [
     [
      0.05,
      1.889,
      "Make the drum's gear bigger."
     ],
     [
      1.889,
      4.181,
      "The drum turns more slowly."
     ]
    ]
   },
   "Narr_Gears_Torque_03": {
    "duration": 5.472,
    "hash": "f70cc7b7e6935e28",
    "sentences": [
     [
      0.05,
      3.681,
      "The drum now turns more slowly than the crank."
     ],
     [
      3.681,
      5.417,
      "What does it get in return?"
     ]
    ]
   },
   "Narr_Gears_Torque_04": {
    "duration": 9.12,
    "hash": "cd4cd48ad4743769",
    "sentences": [
     [
      0.05,
      9.069,
      "Slower but stronger, or faster but weaker: gears trade one for the other, but never make energy from nothing."
     ]
    ]
   },
   "Narr_Gears_Train_01": {
    "duration": 5.856,
    "hash": "78e83bdacf644666",
    "sentences": [
     [
      0.05,
      5.806,
      "One step: a small gear drives a big one, and the speed drops three times."
     ]
    ]
   },
   "Narr_Gears_Train_02": {
    "duration": 8.304,
    "hash": "e8a38f4ca6685c1e",
    "sentences": [
     [
      0.05,
      5.569,
      "Two steps: a small gear fixed to the big one drives the next big gear."
     ],
     [
      5.569,
      8.25,
      "Three times three is nine."
     ]
    ]
   },
   "Narr_Gears_Train_03": {
    "duration": 4.608,
    "hash": "465ce92e3e105a83",
    "sentences": [
     [
      0.05,
      4.542,
      "With three steps, how many times slower is the last gear?"
     ]
    ]
   },
   "Narr_Gears_Train_04": {
    "duration": 5.856,
    "hash": "185efcbab8f74509",
    "sentences": [
     [
      0.05,
      5.792,
      "Your turn: add a fourth step and see how slowly the last gear creeps."
     ]
    ]
   },
   "Narr_Light_Angle_01": {
    "duration": 6.072,
    "hash": "9783db7e41fa496f",
    "sentences": [
     [
      0.05,
      6.014,
      "The car is close, so in your view its two ends are far apart: a wide angle."
     ]
    ]
   },
   "Narr_Light_Angle_02": {
    "duration": 5.04,
    "hash": "d05edc4894301ee6",
    "sentences": [
     [
      0.05,
      4.986,
      "Twice as far away, and the angle between its ends is about half as big."
     ]
    ]
   },
   "Narr_Light_Angle_03": {
    "duration": 5.76,
    "hash": "2833a967ae6ed4ce",
    "sentences": [
     [
      0.05,
      5.694,
      "Your turn: move the car twenty metres away and see how small the angle gets."
     ]
    ]
   },
   "Narr_Light_Angle_04": {
    "duration": 7.344,
    "hash": "ed105ff8959ae300",
    "sentences": [
     [
      0.05,
      2.847,
      "How big something looks is this angle."
     ],
     [
      2.847,
      7.292,
      "For a patch, like a lamp, it is how much of your view it fills."
     ]
    ]
   },
   "Narr_Light_Bounce_01": {
    "duration": 6.936,
    "hash": "bc0a029d7eb40595",
    "sentences": [
     [
      0.05,
      6.875,
      "No bounces: only what the lamp reaches is lit, and the box's far side is pitch black."
     ]
    ]
   },
   "Narr_Light_Bounce_02": {
    "duration": 7.272,
    "hash": "7fde0cd4619aff8b",
    "sentences": [
     [
      0.05,
      1.375,
      "One bounce."
     ],
     [
      1.375,
      7.208,
      "Lit surfaces light each other, and the floor by the red wall picks up a red glow."
     ]
    ]
   },
   "Narr_Light_Bounce_03": {
    "duration": 5.52,
    "hash": "b8508b41e88b2719",
    "sentences": [
     [
      0.05,
      5.458,
      "Your turn: paint the wall blue and watch the glow on the floor change."
     ]
    ]
   },
   "Narr_Light_Bounce_04": {
    "duration": 6.288,
    "hash": "3659d525bb2c8229",
    "sentences": [
     [
      0.05,
      1.528,
      "Three bounces."
     ],
     [
      1.528,
      6.236,
      "Each one adds less than the last, and the shadows fill in."
     ]
    ]
   },
   "Narr_Light_Bounce_05": {
    "duration": 3.528,
    "hash": "0d77bba2754cf662",
    "sentences": [
     [
      0.05,
      3.458,
      "Why is the shade in a room never pitch black?"
     ]
    ]
   },
   "Narr_Light_Brightness_01": {
    "duration": 5.976,
    "hash": "1a92463df03e6a80",
    "sentences": [
     [
      0.05,
      5.917,
      "Here the lamp is turned down low, and only a dim pool of light reaches the floor."
     ]
    ]
   },
   "Narr_Light_Brightness_02": {
    "duration": 6.048,
    "hash": "a3788339f2b04594",
    "sentences": [
     [
      0.05,
      1.264,
      "Double the power."
     ],
     [
      1.264,
      5.986,
      "Twice as much light lands on the floor, and the pool brightens a lot."
     ]
    ]
   },
   "Narr_Light_Brightness_03": {
    "duration": 7.176,
    "hash": "2a8b1aca0d23fa59",
    "sentences": [
     [
      0.05,
      2.264,
      "Now it is eight times that."
     ],
     [
      2.264,
      7.111,
      "More light again, yet the floor hardly looks brighter than before."
     ]
    ]
   },
   "Narr_Light_Brightness_04": {
    "duration": 5.688,
    "hash": "a5736696f51540da",
    "sentences": [
     [
      0.05,
      5.639,
      "So when twice as much light reaches the floor, does the floor look twice as bright?"
     ]
    ]
   },
   "Narr_Light_Brightness_05": {
    "duration": 4.776,
    "hash": "a47ef24110e44b31",
    "sentences": [
     [
      0.05,
      4.747,
      "Your turn: turn the lamp all the way up and watch what happens under it."
     ]
    ]
   },
   "Narr_Light_Distance_01": {
    "duration": 4.584,
    "hash": "17e857097a2e064a",
    "sentences": [
     [
      0.05,
      4.528,
      "Follow the light that goes through one square, one metre from the lamp."
     ]
    ]
   },
   "Narr_Light_Distance_02": {
    "duration": 6.24,
    "hash": "b991fda19aeba9e0",
    "sentences": [
     [
      0.05,
      6.181,
      "At two metres that same light spreads over four squares, so each one gets a quarter."
     ]
    ]
   },
   "Narr_Light_Distance_03": {
    "duration": 3.384,
    "hash": "4cc7b54910cad5d0",
    "sentences": [
     [
      0.05,
      3.333,
      "At three metres it covers nine squares."
     ]
    ]
   },
   "Narr_Light_Distance_04": {
    "duration": 6.264,
    "hash": "3bfffa2c0a1a48c2",
    "sentences": [
     [
      0.05,
      6.208,
      "So at three metres, how much light does each square get, compared with one metre?"
     ]
    ]
   },
   "Narr_Light_Radiance_01": {
    "duration": 4.992,
    "hash": "1071962e8fd0f1fb",
    "sentences": [
     [
      0.05,
      4.931,
      "A glowing panel, straight in front of the eye, two metres away."
     ]
    ]
   },
   "Narr_Light_Radiance_02": {
    "duration": 8.736,
    "hash": "bbe1d0526b0d8258",
    "sentences": [
     [
      0.05,
      2.278,
      "Step back to four metres."
     ],
     [
      2.278,
      8.667,
      "Each bit sends you less, but you take in four times as much of the panel, so it looks just as bright."
     ]
    ]
   },
   "Narr_Light_Radiance_03": {
    "duration": 5.4,
    "hash": "f53ab33406a42d56",
    "sentences": [
     [
      0.05,
      5.333,
      "Your turn: turn the panel away at a slant, and check whether it looks darker."
     ]
    ]
   },
   "Narr_Light_Radiance_04": {
    "duration": 4.944,
    "hash": "cf531af3b9de70ee",
    "sentences": [
     [
      0.05,
      3.222,
      "You walk twice as far away from a lit wall."
     ],
     [
      3.222,
      4.875,
      "How bright does it look?"
     ]
    ]
   },
   "Narr_Light_Reflection_01": {
    "duration": 6.528,
    "hash": "2e1c9e95452f2c27",
    "sentences": [
     [
      0.05,
      6.472,
      "A perfect mirror: the light leaves at the same angle it came in, all in one direction."
     ]
    ]
   },
   "Narr_Light_Reflection_02": {
    "duration": 5.016,
    "hash": "2bee72cf6eefa60a",
    "sentences": [
     [
      0.05,
      4.944,
      "Move the eye away from that direction, and the mirror sends it nothing at all."
     ]
    ]
   },
   "Narr_Light_Reflection_03": {
    "duration": 8.928,
    "hash": "b792839958a0badd",
    "sentences": [
     [
      0.05,
      3.597,
      "Now make the surface fully matte, like paper."
     ],
     [
      3.597,
      8.861,
      "The light scatters every way, so the eye sees the spot from anywhere."
     ]
    ]
   },
   "Narr_Light_Reflection_04": {
    "duration": 4.872,
    "hash": "e60d6248a033ef64",
    "sentences": [
     [
      0.05,
      4.819,
      "Your turn: set the roughness in between, like glossy paint."
     ]
    ]
   },
   "Narr_Light_Reflection_05": {
    "duration": 4.488,
    "hash": "a1cd4e84c25e1679",
    "sentences": [
     [
      0.05,
      4.431,
      "Which surface shows a bright highlight that moves when you move?"
     ]
    ]
   },
   "Narr_Light_Shadow_01": {
    "duration": 7.752,
    "hash": "fd1ae521b985d7ef",
    "sentences": [
     [
      0.05,
      2.361,
      "A tiny lamp over a box."
     ],
     [
      2.361,
      7.694,
      "Each spot of the floor sees all of it or none of it, so the shadow's edge is sharp."
     ]
    ]
   },
   "Narr_Light_Shadow_02": {
    "duration": 7.56,
    "hash": "e9c82c57f91caf12",
    "sentences": [
     [
      0.05,
      1.667,
      "Make the lamp big."
     ],
     [
      1.667,
      7.5,
      "Near the edge, part of the lamp is hidden and part is not, so the shadow fades gently."
     ]
    ]
   },
   "Narr_Light_Shadow_03": {
    "duration": 5.592,
    "hash": "955e323adf7e938d",
    "sentences": [
     [
      0.05,
      5.542,
      "Your turn: raise the lamp as high as it goes and watch the soft edge."
     ]
    ]
   },
   "Narr_Light_Shadow_04": {
    "duration": 3.696,
    "hash": "0181d887ca763a7a",
    "sentences": [
     [
      0.05,
      3.639,
      "Why are shadows so soft on a cloudy day?"
     ]
    ]
   },
   "Narr_Light_Sky_01": {
    "duration": 7.176,
    "hash": "8b9ce0d0273a7ca2",
    "sentences": [
     [
      0.05,
      7.111,
      "Stand on one spot of the floor and look up: a dome of sky, with the lamp right overhead."
     ]
    ]
   },
   "Narr_Light_Sky_02": {
    "duration": 6.648,
    "hash": "eba4c658152e7fbf",
    "sentences": [
     [
      0.05,
      2.778,
      "Press the dome flat into a circle."
     ],
     [
      2.778,
      6.583,
      "The lamp's patch is the share of light this spot gets."
     ]
    ]
   },
   "Narr_Light_Sky_03": {
    "duration": 6.36,
    "hash": "9eea4b2d03ee039f",
    "sentences": [
     [
      0.05,
      1.917,
      "Bring the lamp down low."
     ],
     [
      1.917,
      6.306,
      "Its patch squashes thin near the rim, and the share drops."
     ]
    ]
   },
   "Narr_Light_Sky_04": {
    "duration": 5.28,
    "hash": "5799212022b49833",
    "sentences": [
     [
      0.05,
      5.222,
      "Your turn: move the lamp further away and watch its patch shrink."
     ]
    ]
   },
   "Narr_Light_Sky_05": {
    "duration": 2.736,
    "hash": "a530dacf18414d11",
    "sentences": [
     [
      0.05,
      2.667,
      "Which lamp gives this spot more light?"
     ]
    ]
   },
   "Narr_Light_Tilt_01": {
    "duration": 5.664,
    "hash": "f28f7f62fb81c98e",
    "sentences": [
     [
      0.05,
      5.597,
      "The beam comes straight down, so the lit patch on the board is just as wide as the beam."
     ]
    ]
   },
   "Narr_Light_Tilt_02": {
    "duration": 6.432,
    "hash": "f4fdd43beff0ffe9",
    "sentences": [
     [
      0.05,
      1.222,
      "Tip the board."
     ],
     [
      1.222,
      6.361,
      "The same beam now lands on a longer patch, so each part of it gets less."
     ]
    ]
   },
   "Narr_Light_Tilt_03": {
    "duration": 5.76,
    "hash": "acad89b273818cf9",
    "sentences": [
     [
      0.05,
      5.694,
      "Your turn: tip the board to sixty degrees and read how long the patch gets."
     ]
    ]
   },
   "Narr_Light_Tilt_04": {
    "duration": 5.088,
    "hash": "591169a4ea6b02a4",
    "sentences": [
     [
      0.05,
      2.597,
      "The patch is now twice as long."
     ],
     [
      2.597,
      5.014,
      "How bright is each bit of it?"
     ]
    ]
   },
   "Narr_Watch_Balance_01": {
    "duration": 6.456,
    "hash": "da5f7a0c7f651281",
    "sentences": [
     [
      0.05,
      6.389,
      "The balance swings wide, to and fro, about two and a half times a second."
     ]
    ]
   },
   "Narr_Watch_Balance_02": {
    "duration": 5.376,
    "hash": "922cdcd0755c6ccb",
    "sentences": [
     [
      0.05,
      5.319,
      "Now the swing is much narrower, as when the spring is nearly run down."
     ]
    ]
   },
   "Narr_Watch_Balance_03": {
    "duration": 3.96,
    "hash": "df2027c440c0c377",
    "sentences": [
     [
      0.05,
      1.931,
      "The swing got narrower."
     ],
     [
      1.931,
      3.903,
      "Does the watch slow down?"
     ]
    ]
   },
   "Narr_Watch_Balance_04": {
    "duration": 6.0,
    "hash": "dbe04e5178695b72",
    "sentences": [
     [
      0.05,
      5.969,
      "Your turn: make the hairspring a little stiffer and read how much the watch gains a day."
     ]
    ]
   },
   "Narr_Watch_Balance_05": {
    "duration": 6.624,
    "hash": "9fe1b50f11c6eb82",
    "sentences": [
     [
      0.05,
      6.556,
      "A tiny change in the spring is minutes a day, which is why watchmakers adjust it so carefully."
     ]
    ]
   },
   "Narr_Watch_Escape_01": {
    "duration": 5.808,
    "hash": "0f53d73e6ac0e3eb",
    "sentences": [
     [
      0.05,
      5.75,
      "In slow motion: the lever holds the escape wheel still with one red stone."
     ]
    ]
   },
   "Narr_Watch_Escape_02": {
    "duration": 10.344,
    "hash": "ba99eada26910273",
    "sentences": [
     [
      0.05,
      4.472,
      "The balance swings past the middle and flicks the lever across."
     ],
     [
      4.472,
      9.444,
      "One stone lets go, the wheel jumps, the other stone catches it."
     ],
     [
      9.444,
      10.292,
      "Tick."
     ]
    ]
   },
   "Narr_Watch_Escape_03": {
    "duration": 7.344,
    "hash": "2c5f09c987465b12",
    "sentences": [
     [
      0.05,
      7.292,
      "As the tooth slips past the stone, it gives the lever a small push, and the lever passes it on to the balance."
     ]
    ]
   },
   "Narr_Watch_Escape_04": {
    "duration": 5.328,
    "hash": "ca40bf3a310fedbd",
    "sentences": [
     [
      0.05,
      5.278,
      "Your turn: speed the slow motion up and watch the ticks come faster."
     ]
    ]
   },
   "Narr_Watch_Escape_05": {
    "duration": 3.864,
    "hash": "86203307cc20e379",
    "sentences": [
     [
      0.05,
      3.806,
      "What keeps the balance swinging, hour after hour?"
     ]
    ]
   },
   "Narr_Watch_Hands_01": {
    "duration": 6.264,
    "hash": "f8c1598f39cbfbaf",
    "sentences": [
     [
      0.05,
      6.208,
      "At real speed, the seconds hand sweeps round, and the other hands seem to stand still."
     ]
    ]
   },
   "Narr_Watch_Hands_02": {
    "duration": 5.352,
    "hash": "38e9d6523ba641e9",
    "sentences": [
     [
      0.05,
      5.292,
      "Sixty times faster: the minute hand now goes round once a minute."
     ]
    ]
   },
   "Narr_Watch_Hands_03": {
    "duration": 5.592,
    "hash": "33ef01d3cd0fb3fc",
    "sentences": [
     [
      0.05,
      5.528,
      "Your turn: speed time up as far as it goes and watch the hour hand move."
     ]
    ]
   },
   "Narr_Watch_Hands_04": {
    "duration": 3.744,
    "hash": "d20e29cc708c68d8",
    "sentences": [
     [
      0.05,
      3.681,
      "Which hand is not carried by the going train itself?"
     ]
    ]
   },
   "Narr_Watch_Movement_01": {
    "duration": 6.36,
    "hash": "b4220a04f23b54fb",
    "sentences": [
     [
      0.05,
      2.764,
      "The whole movement, put together."
     ],
     [
      2.764,
      6.306,
      "From here you only see the dial and hands."
     ]
    ]
   },
   "Narr_Watch_Movement_02": {
    "duration": 9.456,
    "hash": "c24f4743b776d566",
    "sentences": [
     [
      0.05,
      9.389,
      "Pull it apart into layers: the main plate, the barrel, the going train, the escapement and balance, the motion works and the dial."
     ]
    ]
   },
   "Narr_Watch_Movement_03": {
    "duration": 3.744,
    "hash": "181e8935e3eb8ff3",
    "sentences": [
     [
      0.05,
      3.681,
      "The dial is hidden now, so you can see the wheels under it."
     ]
    ]
   },
   "Narr_Watch_Movement_04": {
    "duration": 3.216,
    "hash": "4cdaaa4b5bf490b4",
    "sentences": [
     [
      0.05,
      3.153,
      "Your turn: hide the motion works too."
     ]
    ]
   },
   "Narr_Watch_Movement_05": {
    "duration": 6.384,
    "hash": "48e8bb9bdc322b8b",
    "sentences": [
     [
      0.05,
      6.319,
      "Energy flows from the spring at the bottom, up through each layer, to the hands at the top."
     ]
    ]
   },
   "Narr_Watch_Rotor_01": {
    "duration": 4.68,
    "hash": "cdb12e4963284316",
    "sentences": [
     [
      0.05,
      4.625,
      "The wrist moves, and the heavy rotor swings so that it keeps hanging down."
     ]
    ]
   },
   "Narr_Watch_Rotor_02": {
    "duration": 4.728,
    "hash": "7a811411ec6cfa06",
    "sentences": [
     [
      0.05,
      4.667,
      "With the reverser, both directions of swing wind the mainspring."
     ]
    ]
   },
   "Narr_Watch_Rotor_03": {
    "duration": 4.08,
    "hash": "22a0b97f16f0b82d",
    "sentences": [
     [
      0.05,
      4.014,
      "Your turn: take the reverser out and watch the winding."
     ]
    ]
   },
   "Narr_Watch_Rotor_04": {
    "duration": 2.952,
    "hash": "3d365dc7df5b15ae",
    "sentences": [
     [
      0.05,
      2.889,
      "Without the reverser, what happens?"
     ]
    ]
   },
   "Narr_Watch_Rotor_05": {
    "duration": 6.48,
    "hash": "0e30f1c81331f526",
    "sentences": [
     [
      0.05,
      1.194,
      "Put it back."
     ],
     [
      1.194,
      6.417,
      "And once the spring is full, the barrel lets it slip instead of breaking it."
     ]
    ]
   },
   "Narr_Watch_Spring_01": {
    "duration": 5.304,
    "hash": "751e48bc6faac3de",
    "sentences": [
     [
      0.05,
      2.611,
      "The mainspring has almost run down."
     ],
     [
      2.611,
      5.236,
      "It lies loose against the barrel wall."
     ]
    ]
   },
   "Narr_Watch_Spring_02": {
    "duration": 5.016,
    "hash": "f09cb4c3c0584379",
    "sentences": [
     [
      0.05,
      4.971,
      "Your turn: wind the spring all the way up, as the crown would."
     ]
    ]
   },
   "Narr_Watch_Spring_03": {
    "duration": 8.328,
    "hash": "dd28d69dd9e87cdf",
    "sentences": [
     [
      0.05,
      8.264,
      "Wound tight round the arbor, the spring pushes the barrel round, and the barrel's teeth drive the watch for about forty hours."
     ]
    ]
   },
   "Narr_Watch_Spring_04": {
    "duration": 3.024,
    "hash": "014eed7e363ace6d",
    "sentences": [
     [
      0.05,
      2.958,
      "Where does a mechanical watch get its energy?"
     ]
    ]
   }
  },
  "pitch": "+0Hz",
  "rate": "-10%",
  "voice": "en-US-AvaMultilingualNeural"
 },
 "zh-CN": {
  "clips": {
